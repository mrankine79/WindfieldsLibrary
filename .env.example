# Password to log into /manage
MANAGEMENT_PASSWORD=

# Secret used to sign the admin session cookie. Optional — if unset,
# MANAGEMENT_PASSWORD is used instead, but setting a separate long random
# value here is more secure. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# GitHub Personal Access Token with write access to the data repo below
# (fine-grained token scoped to just that repo, Contents: Read and write)
GITHUB_TOKEN=

# The repo that stores books.json / clubs.json / links.json / suggestions.json
DATA_REPO_OWNER=mrankine79
DATA_REPO_NAME=windfieldslibrary-data
DATA_REPO_BRANCH=main
